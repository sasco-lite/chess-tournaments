# MongoDB Connection String (Vercel Env Var)
# Leave empty during local preview to use automatic local JSON fallback
MONGODB_URI=""

# Admin Panel Credentials (Vercel Env Vars)
ADMIN="admin"
PASSWORD="change-this-strong-password"

# Server Port (defaults to 3000)
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
